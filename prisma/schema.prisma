// MominFit — Prisma schema
// PostgreSQL via Supabase, managed by Prisma ORM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── NextAuth tables ──────────────────────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?
  role          String    @default("user")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts             Account[]
  sessions             Session[]
  fitnessProfile       FitnessProfile?
  weeklyPlans          WeeklyPlan[]
  workoutLogs          WorkoutLog[]
  prayerTimes          PrayerTime[]
  chatHistory          ChatMessage[]
  exercisesCreated     Exercise[]
  planTemplatesCreated PlanTemplate[]
  motivationCreated    MotivationMessage[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Application tables ────────────────────────────────────────

model FitnessProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  age          Int?
  heightCm     Float?
  weightKg     Float?
  goal         String? // lose_weight | build_muscle | stay_fit
  fitnessLevel String? // beginner | intermediate | advanced
  equipment    String[] @default([])
  timezone     String?
  city         String?
  prayerMethod String? // karachi | mw | isna
  ramadanMode  Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Exercise {
  id              String   @id @default(cuid())
  name            String
  category        String // strength | cardio | flexibility | sunnah
  description     String?
  equipmentNeeded String[] @default([])
  sourceNotes     String?
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy     User?          @relation(fields: [createdById], references: [id], onDelete: SetNull)
  planTemplates PlanTemplate[]
}

model PlanTemplate {
  id              String   @id @default(cuid())
  name            String
  goal            String? // lose_weight | build_muscle | stay_fit
  fitnessLevel    String? // beginner | intermediate | advanced
  equipment       String[] @default([])
  daysPerWeek     Int? // 1–7
  ramadanFriendly Boolean  @default(false)
  templateData    Json     @default("[]")
  createdById     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy   User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  exercises   Exercise[]
  weeklyPlans WeeklyPlan[]
}

model WeeklyPlan {
  id             String   @id @default(cuid())
  userId         String
  weekStart      DateTime
  planTemplateId String?
  planData       Json     @default("{}")
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  planTemplate PlanTemplate? @relation(fields: [planTemplateId], references: [id], onDelete: SetNull)
  workoutLogs  WorkoutLog[]

  @@index([userId, weekStart])
}

model WorkoutLog {
  id           String    @id @default(cuid())
  userId       String
  weeklyPlanId String?
  logDate      DateTime
  completed    Boolean   @default(false)
  completedAt  DateTime?
  notes        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  weeklyPlan WeeklyPlan? @relation(fields: [weeklyPlanId], references: [id], onDelete: SetNull)

  @@index([userId, logDate])
}

model PrayerTime {
  id         String   @id @default(cuid())
  userId     String
  prayerDate DateTime
  fajr       DateTime
  dhuhr      DateTime
  asr        DateTime
  maghrib    DateTime
  isha       DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, prayerDate])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  role      String // user | assistant
  content   String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model MotivationMessage {
  id          String   @id @default(cuid())
  message     String
  reference   String?
  isActive    Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User? @relation(fields: [createdById], references: [id], onDelete: SetNull)
}
